# Copy to supabase/.env and fill in. Function secrets — NEVER commit real values.
#
# Local dev:  supabase functions serve --env-file supabase/.env
# Production: supabase secrets set --env-file supabase/.env
#
# Read in Edge Functions via supabase/functions/_shared/env.ts (`config.*` accessors).
#
# Required for MVP:
#   ANTHROPIC_API_KEY, GOOGLE_PLACES_API_KEY, INGEST_SECRET, SUPABASE_SERVICE_ROLE_KEY
# Optional (ingest fallbacks):
#   REDDIT_USER_AGENT, EVENTBRITE_TOKEN, DICE_TOKEN

ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# Server-side Supabase access for Edge Functions (DB writes, admin auth). NOT the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Cron secret — shared between pg_cron and the ingest-events Edge Function
INGEST_SECRET=

# Reddit (read-only public JSON works without keys; set if you want higher rate limits)
REDDIT_USER_AGENT=

# Eventbrite + DICE optional — fallback is HTML scrape via web search
EVENTBRITE_TOKEN=
DICE_TOKEN=
