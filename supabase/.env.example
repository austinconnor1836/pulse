# Copy to supabase/.env and fill in. Function secrets — NEVER commit real values.
# Push to prod with: supabase secrets set --env-file supabase/.env

ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# Reddit (read-only public JSON works without keys; set if you want higher rate limits)
REDDIT_USER_AGENT=

# Eventbrite + DICE optional — fallback is HTML scrape via web search
EVENTBRITE_TOKEN=
DICE_TOKEN=

# Cron secret — shared between pg_cron and the ingest-events Edge Function
INGEST_SECRET=
