# OS
.DS_Store
*.swp

# IDE
.vscode/
.idea/
*.iml

# Env (real keys never go in git)
.env
.env.local
.env.*.local
**/Config.local.xcconfig

# ---------- iOS ----------

# Generated by xcodegen — regenerate locally, don't commit
ios/Pulse.xcodeproj/
ios/*.xcworkspace/

# Xcode user data
**/xcuserdata/
**/*.xcuserstate
**/DerivedData/
**/build/

# Swift Package Manager
**/.swiftpm/
**/Package.resolved

# CocoaPods (not currently used)
**/Pods/

# ---------- Android / Gradle ----------

# Gradle build outputs
.gradle/
**/build/
local.properties

# Gradle wrapper jar — checked in by AS on first open
# (We do commit it once AS generates it)
!gradle/wrapper/gradle-wrapper.jar

# Android Studio
captures/
.cxx/

# Kotlin compile outputs
**/.kotlin/

# ---------- KMP / Native ----------

# Kotlin Native build outputs
**/.konan/

# Generated XCFrameworks (rebuild on demand)
shared/build/XCFrameworks/

# ---------- Ruby / fastlane (iOS ship tooling) ----------

# Bundled gems — reinstall with `bundle install`, don't commit (~65M)
ios/vendor/
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/test_output/

# ---------- Supabase ----------

supabase/.branches
supabase/.temp
supabase/functions/_node_modules
